Cell["\<\
ManualSamplePreparation to prepare samples for injection
(peroxide dilution, catalyst transfer)\
\>", "Subsection",ExpressionUUID->"580c51e4-6fa3-4440-94b6-4474793bbe2f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"manualInputPrep", " ", "=", " ", 
   RowBox[{"ExperimentManualSamplePreparation", "[", "\n", "\t", 
    RowBox[{
     RowBox[{"{", "\n", "\t\t", 
      RowBox[{
       RowBox[{"LabelContainer", "[", "\n", "\t\t\t", 
        RowBox[{"<|", "\n", "\t\t\t\t", 
         RowBox[{
          RowBox[{"Label", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<PeroxideTube\>\"", ",", 
             " ", "\"\<OtherPeroxideTube\>\"", ",", 
             " ", "\"\<CatalystTube\>\""}], "}"}]}], ",", "\n", "\t\t\t\t", 
          RowBox[{"Container", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Model", "[", 
              RowBox[{
              "Container", ",", " ", "Vessel", ",", " ", "\"\<2mL Tube\>\""}],
               "]"}], ",", " ", 
             RowBox[{"Model", "[", 
              RowBox[{
              "Container", ",", " ", "Vessel", ",", " ", "\"\<2mL Tube\>\""}],
               "]"}], ",", " ", 
             RowBox[{"Model", "[", 
              RowBox[{
              "Container", ",", " ", "Vessel", ",", " ", "\"\<2mL Tube\>\""}],
               "]"}]}], "}"}]}]}], "\n", "\t\t\t", "|>"}], "\n", "\t\t", 
        "]"}], ",", "\n", "\t\t", 
       RowBox[{"Transfer", "[", "\n", "\t\t\t", 
        RowBox[{"<|", "\n", "\t\t\t\t", 
         RowBox[{
          RowBox[{"Source", " ", "\[Rule]", " ", 
           RowBox[{"{", "\n", "\t\t\t\t\t", 
            RowBox[{
             RowBox[{"Model", "[", 
              RowBox[{
              "Sample", ",", " ", "StockSolution", ",", 
               " ", "\"\<0.125mM NT-7 Catalyst 01-29-25\>\""}], "]"}], ",", 
             "\n", "\t\t\t\t\t", 
             RowBox[{"Model", "[", 
              RowBox[{
              "Sample", ",", 
               " ", "\"\<Hydrogen peroxide solution contains inhibitor, 30wt. \
% in H2O, ACS reagent | H2O2\>\""}], "]"}], ",", "\n", "\t\t\t\t\t", 
             RowBox[{"Model", "[", 
              RowBox[{"Sample", ",", " ", "\"\<Milli-Q water\>\""}], "]"}], ",",
              "\n", "\t\t\t\t\t", "\"\<PeroxideTube\>\""}], "\n", "\t\t\t\t", 
            "}"}]}], ",", "\n", "\t\t\t\t", 
          RowBox[{"Destination", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<CatalystTube\>\"", ",", " ", "\"\<PeroxideTube\>\"", 
             ",", " ", "\"\<PeroxideTube\>\"", ",", 
             " ", "\"\<OtherPeroxideTube\>\""}], "}"}]}], ",", "\n", 
          "\t\t\t\t", 
          RowBox[{"Amount", " ", "\[Rule]", " ", 
           RowBox[{"{", "\n", "\t\t\t\t\t", 
            RowBox[{
             RowBox[{"Quantity", "[", 
              RowBox[{"1.5", ",", " ", "\"\<Milliliters\>\""}], "]"}], ",", 
             "\n", "\t\t\t\t\t", 
             RowBox[{"Quantity", "[", 
              RowBox[{"18", ",", " ", "\"\<Microliters\>\""}], "]"}], ",", 
             "\n", "\t\t\t\t\t", 
             RowBox[{"Quantity", "[", 
              RowBox[{"1782", ",", " ", "\"\<Microliters\>\""}], "]"}], ",", 
             "\n", "\t\t\t\t\t", 
             RowBox[{"Quantity", "[", 
              RowBox[{"400", ",", " ", "\"\<Microliters\>\""}], "]"}]}], "\n",
             "\t\t\t\t", "}"}]}], ",", "\n", "\t\t\t\t", 
          RowBox[{"SourceLabel", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<transfer source sample 1\>\"", ",", 
             " ", "\"\<transfer source sample 2\>\"", ",", 
             " ", "\"\<transfer source sample 3\>\"", ",", 
             " ", "\"\<transfer source sample 4\>\""}], "}"}]}], ",", "\n", 
          "\t\t\t\t", 
          RowBox[{"SourceContainerLabel", " ", "\[Rule]", " ", 
           RowBox[{"{", "\n", "\t\t\t\t\t", 
            
            RowBox[{"\"\<transfer source container 1\>\"", ",", 
             " ", "\"\<transfer source container 2\>\"", ",", 
             " ", "\"\<transfer source container 3\>\"", ",", "\n", 
             "\t\t\t\t\t", "\"\<PeroxideTube\>\""}], "\n", "\t\t\t\t", 
            "}"}]}], ",", "\n", "\t\t\t\t", 
          RowBox[{"DestinationLabel", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Catalyst\>\"", ",", " ", "\"\<Peroxide\>\"", ",", 
             " ", "\"\<Peroxide\>\"", ",", " ", "\"\<OtherPeroxide\>\""}], 
            "}"}]}], ",", "\n", "\t\t\t\t", 
          RowBox[{"DestinationContainerLabel", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<CatalystTube\>\"", ",", " ", "\"\<PeroxideTube\>\"", 
             ",", " ", "\"\<PeroxideTube\>\"", ",", 
             " ", "\"\<OtherPeroxideTube\>\""}], "}"}]}], ",", "\n", 
          "\t\t\t\t", 
          RowBox[{"SourceWell", " ", "\[Rule]", " ", "\"\<A1\>\""}], ",", " ", 
          RowBox[{"DestinationWell", " ", "\[Rule]", " ", "\"\<A1\>\""}], ",",
           "\n", "\t\t\t\t", 
          RowBox[{"DispenseMix", " ", "\[Rule]", " ", "True"}], ",", " ", 
          RowBox[{"KeepSourceCovered", " ", "\[Rule]", " ", "True"}], ",", 
          " ", 
          RowBox[{"KeepDestinationCovered", " ", "\[Rule]", " ", "True"}], ",",
           "\n", "\t\t\t\t", 
          RowBox[{"Preparation", " ", "\[Rule]", " ", "Manual"}], ",", " ", 
          RowBox[{"MeasureWeight", " ", "\[Rule]", " ", "False"}], ",", " ", 
          RowBox[{"MeasureVolume", " ", "\[Rule]", " ", "False"}], ",", " ", 
          RowBox[{"ImageSample", " ", "\[Rule]", " ", "False"}]}], "\n", 
         "\t\t\t", "|>"}], "\n", "\t\t", "]"}]}], "\n", "\t", "}"}], ",", 
     "\n", "\t", 
     RowBox[{"ParentProtocol", " ", "\[Rule]", " ", "Null"}], ",", " ", 
     RowBox[{"ImageSample", " ", "\[Rule]", " ", "False"}], ",", " ", 
     RowBox[{"MeasureVolume", " ", "\[Rule]", " ", "False"}], ",", " ", 
     RowBox[{"MeasureWeight", " ", "\[Rule]", " ", "False"}], ",", " ", 
     RowBox[{"Site", " ", "->", " ", 
      RowBox[{"Object", "[", 
       RowBox[{"Container", ",", " ", "Site", ",", " ", "\"\<ECL-CMU\>\""}], 
       "]"}]}]}], "\n", "]"}]}], ";"}]], "Code",
