          RowBox[{"Label", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<PeroxideTube\>\"", ",", 
             " ", "\"\<OtherPeroxideTube\>\"", ",", 
             " ", "\"\<CatalystTube\>\""}], "}"}]}], ",", "\n", "\t\t\t\t", 
          RowBox[{"Container", " ", "\[Rule]", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Model", "[", 
              RowBox[{
              "Container", ",", " ", "Vessel", ",", " ", "\"\<2mL Tube\>\""}],
               "]"}], ",", " ", 
             RowBox[{"Model", "[", 
