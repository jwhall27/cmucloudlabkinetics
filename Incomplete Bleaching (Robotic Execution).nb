               "]"}]}], "}"}]}]}], "\n", "\t\t\t", "|>"}], "\n", "\t\t", 
        "]"}], ",", "\n", "\t\t", 
       RowBox[{"Transfer", "[", "\n", "\t\t\t", 
        RowBox[{"<|", "\n", "\t\t\t\t", 
         RowBox[{
          RowBox[{"Source", " ", "\[Rule]", " ", 
           RowBox[{"{", "\n", "\t\t\t\t\t", 
            RowBox[{
             RowBox[{"Model", "[", 
              RowBox[{
              "Sample", ",", " ", "StockSolution", ",", 
               " ", "\"\<0.125mM NT-7 Catalyst 01-29-25\>\""}], "]"}], ",", 
             "\n", "\t\t\t\t\t", 
             RowBox[{"Model", "[", 
              RowBox[{"Sample", ",", " ", "\"\<Milli-Q water\>\""}], "]"}], ",",
              "\n", "\t\t\t\t\t", 
             RowBox[{"Model", "[", 
              RowBox[{
              "Sample", ",", 
               " ", "\"\<Hydrogen peroxide solution contains inhibitor, 30wt. \
% in H2O, ACS reagent | H2O2\>\""}], "]"}], ",", "\n", "\t\t\t\t\t", 
             RowBox[{"Model", "[", 
              RowBox[{"Sample", ",", " ", "\"\<Milli-Q water\>\""}], "]"}], ",",
