Cell["\<\
Manual preparation of injection samples (peroxide dilution x2, catalyst \
dilution)\
\>", "Subsection",ExpressionUUID->"79bf443d-4fc3-4716-8656-0261457202c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"manualInputPrep", " ", "=", " ", 
   RowBox[{"ExperimentManualSamplePreparation", "[", "\n", "\t", 
    RowBox[{
     RowBox[{"{", "\n", "\t\t", 
      RowBox[{
       RowBox[{"LabelContainer", "[", "\n", "\t\t\t", 
        RowBox[{"<|", "\n", "\t\t\t\t", 
